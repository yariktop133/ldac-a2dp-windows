<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{717BD57A-0302-429F-9649-26BACCB58994}</ProjectGuid>
    <TemplateGuid>{1bc93793-694f-48fe-9372-81e2b05556fd}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <Configuration>Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RootNamespace>LdacA2dp</RootNamespace>
    <WindowsTargetPlatformVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!-- ACX 1.1 (Windows 11 22H2+) needs KMDF 1.31 -->
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>31</KMDF_VERSION_MINOR>
    <ACX_VERSION_MAJOR>1</ACX_VERSION_MAJOR>
    <ACX_VERSION_MINOR>1</ACX_VERSION_MINOR>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <PropertyGroup>
    <DebuggerFlavor>DbgengKernelDebugger</DebuggerFlavor>
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\LdacA2dp\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\build\LdacA2dp\obj\$(Configuration)\</IntDir>
    <!-- Signed on the test machine with its own certificate, not at build time. -->
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>..\..\avdtp\include;$(DDK_INC_PATH)\acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>ACX_VERSION_MAJOR=$(ACX_VERSION_MAJOR);ACX_VERSION_MINOR=$(ACX_VERSION_MINOR);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
    <Link>
      <AdditionalDependencies>acx\km\$(ACX_VERSION_MAJOR).$(ACX_VERSION_MINOR)\acxstub.lib;ksguid.lib;vhfkm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <!-- grows with every build, so pnputil replaces an installed test build of the same day -->
      <TimeStamp>0.2.$([System.DateTime]::UtcNow.DayOfYear).$([System.DateTime]::UtcNow.ToString("HHmm"))</TimeStamp>
      <!-- UTC date: with stampinf's local date inf2cat rejects DriverVer as "in the future"
           during the hours when local time is a day ahead of UTC. -->
      <SpecifyDriverVerDirectiveDate>true</SpecifyDriverVerDirectiveDate>
      <DateStamp>$([System.DateTime]::UtcNow.ToString("MM'/'dd'/'yyyy"))</DateStamp>
    </Inf>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="l2cap.c" />
    <ClCompile Include="avdtp_glue.c" />
    <ClCompile Include="ioctl.c" />
    <ClCompile Include="audio.c" />
    <ClCompile Include="avrcp_glue.c" />
    <!-- shared AVDTP / A2DP core, the same sources the user-mode tests exercise -->
    <ClCompile Include="..\..\avdtp\src\avdtp_msg.c" />
    <ClCompile Include="..\..\avdtp\src\a2dp_codec.c" />
    <ClCompile Include="..\..\avdtp\src\avdtp_source.c" />
    <ClCompile Include="..\..\avdtp\src\avdtp_media.c" />
    <ClCompile Include="..\..\avdtp\src\avrcp.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="driver.h" />
    <ClInclude Include="public.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="LdacA2dp.inx" />
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
